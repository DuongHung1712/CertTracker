NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Local value: `pnpm supabase status` (service_role key). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Cron endpoints authenticate with `Authorization: Bearer ${CRON_SECRET}` — at least 16 random characters.
CRON_SECRET=
# Email. Without RESEND_API_KEY (and outside production) mails are only logged to the server console.
RESEND_API_KEY=
EMAIL_FROM=CertTracker <noreply@example.com>
# Optional: "console" forces console transport (use for e2e); "resend" forces Resend.
EMAIL_TRANSPORT=
# Public base URL used for links in emails, e.g. https://cert-tracker-three.vercel.app
APP_URL=http://localhost:3000

# AI (certificate reader). Server-only: never prefix with NEXT_PUBLIC_. See docs/superpowers/specs/2026-11-22-ai-certificate-reader-design.md
# "fake" returns sample answers (dev/test only, refused in production); "deepseek" calls the provider. Unset in dev means fake.
AI_TRANSPORT=
DEEPSEEK_API_KEY=
# Optional overrides; defaults shown.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Fields the model is less sure about than this (0-1) stay empty in the form.
AI_CONFIDENCE_THRESHOLD=0.6
# USD per million tokens, used for the logged cost estimate (defaults are the flash peak prices).
AI_PRICE_INPUT_PER_M=0.30
AI_PRICE_OUTPUT_PER_M=1.20
