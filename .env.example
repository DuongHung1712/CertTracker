NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Local value: `pnpm supabase status` (service_role key). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Cron endpoints authenticate with `Authorization: Bearer ${CRON_SECRET}` — at least 16 random characters.
CRON_SECRET=
# Email. Without RESEND_API_KEY (and outside production) mails are only logged to the server console.
RESEND_API_KEY=
EMAIL_FROM=CertTracker <noreply@example.com>
# Optional: "console" forces console transport (use for e2e); "resend" forces Resend.
EMAIL_TRANSPORT=
# Public base URL used for links in emails, e.g. https://cert-tracker-three.vercel.app
APP_URL=http://localhost:3000
